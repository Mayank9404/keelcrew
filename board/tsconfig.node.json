{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "scripts",
    "dev/vite.config.ts",
    "dev/page.mjs"
  ]
}
